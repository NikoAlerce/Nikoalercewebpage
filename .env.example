# Endpoint GraphQL p\u00fablico de Objkt (Tezos)
NEXT_PUBLIC_OBJKT_GRAPHQL=https://data.objkt.com/v3/graphql

# \u2500\u2500 Analytics privados (/stats) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500
# API token de GoatCounter: en tu panel \u2192 [Usuario] \u2192 API \u2192 crear token.
# Es SECRETO: vive solo en el server (nunca NEXT_PUBLIC_). Sin \u00e9l, /stats muestra
# instrucciones de setup en vez de datos.
GOATCOUNTER_API_TOKEN=
# Contrase\u00f1a para entrar a /stats (eleg\u00ed cualquier string largo). Si la dej\u00e1s
# vac\u00eda, /stats queda ABIERTO a cualquiera \u2014 pon\u00e9 algo para mantenerlo privado.
STATS_ACCESS_KEY=
# Opcional: URL del sitio en GoatCounter. Por defecto https://nikoalerce.goatcounter.com
# GOATCOUNTER_SITE=https://nikoalerce.goatcounter.com

# Aliases por defecto (separar con coma)
NEXT_PUBLIC_OBJKT_ALIASES=nikoalerce,sidequest

# Wallet override opcional (tz1...). Si est\u00e1 vac\u00edo, se usa el alias.
NEXT_PUBLIC_OBJKT_WALLET=

# Beacon: URL p\u00fablica del sitio (fallback si window no est\u00e1 disponible en init).
# NEXT_PUBLIC_SITE_URL=https://nikoalercewebpage.vercel.app

# Beacon / WalletConnect (opcional). Project ID de https://cloud.walletconnect.com — mejora pairing m\u00f3vil.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Icono del dApp en el modal de Beacon (opcional, URL absoluta).
# NEXT_PUBLIC_BEACON_ICON_URL=

# Beacon Matrix relays (opcional): lista separada por comas de hostnames sin https://.
# Por defecto el sitio usa solo nodos *.octez.io (los *.papers.tech por defecto del SDK suelen estar ca\u00eddos o sin CORS).
# NEXT_PUBLIC_BEACON_MATRIX_NODES=beacon-node-1.octez.io,beacon-node-2.octez.io
